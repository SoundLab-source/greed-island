# Copy to .env. Matches docker-compose.yml (local-only credentials).
DATABASE_URL="postgresql://greed:greed@localhost:54329/greed_island"
TEST_DATABASE_URL="postgresql://greed:greed@localhost:54329/greed_island_test"

# Economy (integer Salt). Defaults live in packages/shared/src/config.ts.
# GI_STARTING_BALANCE=400
# GI_DAILY_GRANT=100
# GI_BAILOUT_FLOOR=100
# GI_MIN_BET=1
# GI_MAX_PAYOUT=50000
# Salt paid to a character's owner for each win on stream (not tournaments); 0 turns it off.
# GI_OWNER_REWARD=25

# Ratings and tiers. Defaults live in packages/shared/src/{glicko2,tiers}.ts.
# GI_GLICKO_TAU=0.5
# GI_TIER_B=1450
# GI_TIER_A=1600
# GI_TIER_S=1750
# GI_TIER_HYSTERESIS=25

# Path to your IKEMEN GO install (folder containing chars/, stages/, external/).
# IKEMEN_DIR=/absolute/path/to/Ikemen_GO

# Odds (integers; bp = 1/10000). Defaults live in packages/shared/src/odds.ts.
# GI_MARGIN_BP=500
# GI_MIN_CHANCE_BP=500
# GI_MIN_MULTIPLIER_BP=10000
# GI_CROWD_CAP_PER_ACCOUNT=1000
# GI_CROWD_BLEND_K=10000
# GI_CROWD_MAX_WEIGHT_BP=0
# GI_OWNER_BET_CAP=100

# Engine. ENGINE_MODE: fake (no IKEMEN), live (real time, settles bets), sim (fast, smoke tests only).
# ENGINE_MODE=fake
# GI_ENGINE_TIMEOUT_MS=600000
# GI_SIM_TIMEOUT_MS=180000
# GI_AI_LEVEL=8
# GI_SIM_SPEED=4
# GI_IKEMEN_ARGS=-windowed
# Bring each fight's game window to the front (macOS; for streaming with whole-screen capture). It takes focus.
# GI_GAME_TO_FRONT=false
# IKEMEN_BIN=/path/to/Ikemen_GO binary (only if it isn't found automatically)

# Match cycle. Defaults live in packages/orchestrator/src/config.ts.
# GI_BETTING_WINDOW_MS=60000
# GI_INTER_FIGHT_MS=5000
# GI_IDLE_RETRY_MS=10000
# GI_ROUNDS_TO_WIN=2
# GI_MATCH_TARGET_MIN_BP=4000
# GI_MATCH_TARGET_MAX_BP=6000
# GI_UPSET_RATE=0.1
# GI_REMATCH_COOLDOWN=3
# GI_CROSS_TIER_FALLBACK=true
# GI_CYCLE_MATCHMAKING=100
# GI_CYCLE_TOURNAMENT_SIZE=16
# GI_CYCLE_EXHIBITIONS=25

# Dev server (pnpm dev)
# GI_HOST=127.0.0.1
# GI_PORT=3000

# Accounts (email sign-in). Without GI_SMTP_URL, sign-in links are printed in the pnpm dev console.
# GI_PUBLIC_URL=http://127.0.0.1:3000
# GI_SMTP_URL=smtps://user:password@smtp.example.com:465
# GI_MAIL_FROM=Greed Island <no-reply@example.com>
# GI_SESSION_DAYS=30
# GI_LOGIN_LINK_MINUTES=15
# GI_LOGIN_LINKS_PER_HOUR=5

# Shop. Defaults live in packages/shared/src/shop.ts (docs/PHASE2.md).
# GI_SHOP_ROTATION_HOURS=5
# GI_SHOP_SLOTS=6
# GI_SHOP_BASE_PRICE=1000
# GI_FIRST_EDITION_SUPPLY=25
# GI_OWNED_START_RATING=1350
# GI_MAX_OWNED=10

# Upgrades. Defaults live in packages/shared/src/upgrades.ts (docs/PHASE2.md).
# GI_UPGRADE_COST_GROWTH_BP=16000
# GI_SIDEGRADE_COST=300
# GI_UPGRADE_RD_WIDEN=30

# Exhibitions (owner-vs-owner challenges). Defaults live in packages/shared/src/exhibitions.ts.
# Hours a challenge waits for an answer:
# GI_CHALLENGE_TTL_HOURS=24
# Challenges a player can have open at once (waiting for an answer or to be played):
# GI_MAX_OPEN_CHALLENGES=5
# House showcases (when no challenge is waiting) pair characters from this many of the strongest house characters:
# GI_SHOWCASE_POOL=6

# Tournaments. The bracket size is GI_CYCLE_TOURNAMENT_SIZE (default 16; below 2 turns tournaments off).
# T-Salt each player gets per tournament (never moves to the main balance):
# GI_TOURNAMENT_BALANCE=1000
# How many top T-Salt balances earn a title (0-3):
# GI_TOURNAMENT_PODIUM=3

# Custom character names (phase 3): after a name is approved, days before the owner can ask for another.
# GI_RENAME_COOLDOWN_DAYS=7

# Seasons (phase 3): length in weeks, and what the season titles need
# (Season Champion: fights that season; Season Top Bettor: settled Salt bets that season).
# GI_SEASON_WEEKS=8
# GI_SEASON_MIN_FIGHTS=10
# GI_SEASON_MIN_BETS=10

# Fighter submissions (phase 3). Staff-only until opened (it waits for the terms for submitted art).
# GI_SUBMISSIONS_OPEN=false
# Where submitted images are stored (default: submissions/ in the project folder, never committed).
# GI_SUBMISSIONS_DIR=
# GI_SUBMISSION_MAX_FILE_MB=8
# GI_SUBMISSION_MAX_FILES=24

# Voting (phase 3): the last days of each season, who can vote, and how many fighters are elected.
# GI_VOTING_DAYS=14
# GI_VOTES_PER_VOTER=3
# GI_VOTER_MIN_AGE_DAYS=14
# GI_VOTER_MIN_BETS=20
# GI_ELECTED_PER_SEASON=2

# Holders (phase 3): an https DAS endpoint for reading Solana NFTs (from an RPC provider; it
# usually contains an API key, so keep it here in .env). Empty: NFT features show "not set up".
# GI_SOLANA_RPC_URL=
# Wallets one account can link:
# GI_MAX_WALLETS=3

# OBS scene switching (optional; docs/SETUP.md §5). OBS 28+: Tools → WebSocket Server Settings.
# Leave GI_OBS_URL empty to turn it off.
# GI_OBS_URL=ws://127.0.0.1:4455
# GI_OBS_PASSWORD=
# GI_OBS_FIGHT_SCENE=Fight
# GI_OBS_BETTING_SCENE=Betting

# Watch page (/watch.html): the Twitch channel whose player and chat it shows. Empty shows the live betting board.
# GI_TWITCH_CHANNEL=
