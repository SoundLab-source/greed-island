# Copy to .env. Matches docker-compose.yml (local-only credentials).
DATABASE_URL="postgresql://greed:greed@localhost:54329/greed_island"
TEST_DATABASE_URL="postgresql://greed:greed@localhost:54329/greed_island_test"

# Economy (integer Salt). Defaults live in packages/shared/src/config.ts.
# GI_STARTING_BALANCE=400
# GI_DAILY_GRANT=100
# GI_BAILOUT_FLOOR=100
# GI_MIN_BET=1
# GI_MAX_PAYOUT=50000

# Ratings and tiers. Defaults live in packages/shared/src/{glicko2,tiers}.ts.
# GI_GLICKO_TAU=0.5
# GI_TIER_B=1450
# GI_TIER_A=1600
# GI_TIER_S=1750
# GI_TIER_HYSTERESIS=25

# Path to your IKEMEN GO install (folder containing chars/, stages/, external/).
# IKEMEN_DIR=/absolute/path/to/Ikemen_GO
