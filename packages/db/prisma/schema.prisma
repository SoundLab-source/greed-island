// Greed Island database schema.
// Money columns are numeric(20,0) and handled as bigint in TypeScript.
// Extra guarantees (zero-sum transactions, immutable entries, trigger-maintained
// balances, non-negative user/escrow accounts) live in the SQL migrations.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "ts"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Asset {
  SALT
}

enum UserKind {
  ANONYMOUS
  EMAIL
}

enum AccountKind {
  USER
  ESCROW
  HOUSE
  ISSUANCE
  /// Salt spent in the shop and on upgrades leaves circulation here (DESIGN §9).
  SINK
}

enum TxnKind {
  GRANT_START
  GRANT_DAILY
  BAILOUT
  BET
  SETTLE
  VOID
  PURCHASE
  UPGRADE
  /// Paid to a character's owner when it wins on stream (phase 2).
  OWNER_REWARD
}

enum BetStatus {
  OPEN
  WON
  LOST
  REFUNDED
}

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind             UserKind
  /// Lower-cased. Unique when present.
  email            String?   @unique
  /// Set when the player proved they own the email (sign-in link).
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// Reserved for a later phase. Nothing in phase 1 reads or writes it.
  walletAddress    String?   @unique @map("wallet_address")
  displayName      String?   @map("display_name")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  accounts         Account[]
  bets             Bet[]
  /// Owned characters arrive in phase 2; phase 1 characters are all house-owned.
  characters       Character[]
  sessions         Session[]
  loginTokens      LoginToken[]
  characterChanges CharacterChange[]
  titlesEarned     CharacterTitle[]
  challengesSent   Challenge[]       @relation("ChallengeFrom")
  challengesGot    Challenge[]       @relation("ChallengeTo")

  @@map("user")
}

model Account {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// e.g. "user:<id>:SALT", "escrow:<fightId>:1:SALT", "house:SALT", "issuance:SALT"
  key       String        @unique
  kind      AccountKind
  asset     Asset         @default(SALT)
  userId    String?       @map("user_id") @db.Uuid
  user      User?         @relation(fields: [userId], references: [id])
  /// Escrow accounts only.
  fightId   String?       @map("fight_id") @db.Uuid
  fight     Fight?        @relation(fields: [fightId], references: [id])
  side      Int?          @db.SmallInt
  /// Maintained by a trigger on ledger_entry; never written by the app.
  balance   Decimal       @default(0) @db.Decimal(20, 0)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  entries   LedgerEntry[]

  @@index([userId])
  @@index([fightId])
  @@map("account")
}

model LedgerTxn {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotencyKey String        @unique @map("idempotency_key")
  /// SHA-256 of the request that created this txn, to catch key reuse.
  requestHash    String        @map("request_hash")
  kind           TxnKind
  userId         String?       @map("user_id") @db.Uuid
  fightId        String?       @map("fight_id") @db.Uuid
  fight          Fight?        @relation(fields: [fightId], references: [id])
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  entries        LedgerEntry[]
  purchased      Character?
  characterChange CharacterChange?

  @@index([userId])
  @@index([fightId])
  @@map("ledger_txn")
}

model LedgerEntry {
  id        BigInt    @id @default(autoincrement())
  txnId     String    @map("txn_id") @db.Uuid
  txn       LedgerTxn @relation(fields: [txnId], references: [id])
  accountId String    @map("account_id") @db.Uuid
  account   Account   @relation(fields: [accountId], references: [id])
  /// Signed and non-zero: positive credits the account.
  amount    Decimal   @db.Decimal(20, 0)
  betId     String?   @map("bet_id") @db.Uuid

  @@index([txnId])
  @@index([accountId])
  @@index([betId])
  @@map("ledger_entry")
}

/// One row per user per fight: only the latest bet counts.
model Bet {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  fightId   String    @map("fight_id") @db.Uuid
  fight     Fight     @relation(fields: [fightId], references: [id])
  side      Int       @db.SmallInt
  stake     Decimal   @db.Decimal(20, 0)
  status    BetStatus @default(OPEN)
  /// Salt returned at settlement: payout if WON, stake if REFUNDED, 0 if LOST.
  returned  Decimal?  @db.Decimal(20, 0)
  placedAt  DateTime  @default(now()) @map("placed_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, fightId])
  @@index([fightId, status])
  @@map("bet")
}

// ---------------------------------------------------------------------------
// Roster, ratings and tiers (build step 2)

enum Tier {
  P
  B
  A
  S
  X
}

enum Archetype {
  RUSHDOWN
  ZONER
  GRAPPLER
  ALL_ROUNDER
  HEAVY
}

enum Sidegrade {
  BRUISER
  GLASS_CANNON
  IRON_WALL
}

enum CharacterChangeKind {
  UPGRADE
  SIDEGRADE
}

enum Rarity {
  COMMON
  RARE
  LEGENDARY
}

enum OwnerKind {
  HOUSE
  USER
}

enum TierChangeReason {
  INITIAL
  RATING
  MANUAL
}

/// A design in the fighter pool (art, moves, AI). Synced from roster.json.
model Fighter {
  /// Slug from roster.json, e.g. "kfm".
  id             String      @id
  displayName    String      @map("display_name")
  archetype      Archetype
  /// Shop price multiplier (DESIGN §8).
  rarity         Rarity      @default(COMMON)
  /// Path to the character .def, relative to IKEMEN_DIR.
  defPath        String      @map("def_path")
  licenseNote    String      @map("license_note")
  enabled        Boolean     @default(true)
  disabledReason String?     @map("disabled_reason")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  characters     Character[]

  @@map("fighter")
}

/// A stage. Synced from roster.json.
model Stage {
  id             String   @id
  displayName    String   @map("display_name")
  /// Path to the stage .def, relative to IKEMEN_DIR.
  defPath        String   @map("def_path")
  licenseNote    String   @map("license_note")
  enabled        Boolean  @default(true)
  disabledReason String?  @map("disabled_reason")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  fights         Fight[]

  @@map("stage")
}

/// One instance of a fighter, with its own stats, record, rating and tier.
model Character {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Key from roster.json for house characters; null for player-owned ones (phase 2).
  rosterKey      String?       @unique @map("roster_key")
  /// Owned characters: copy number of this fighter (1, 2, ...). The first N are First Edition.
  serial         Int?
  firstEdition   Boolean       @default(false) @map("first_edition")
  acquiredAt     DateTime?     @map("acquired_at") @db.Timestamptz(3)
  /// The purchase that created this character (so a repeated buy request returns it).
  acquiredTxnId  String?       @unique @map("acquired_txn_id") @db.Uuid
  acquiredTxn    LedgerTxn?    @relation(fields: [acquiredTxnId], references: [id])
  fighterId      String        @map("fighter_id")
  fighter        Fighter       @relation(fields: [fighterId], references: [id])
  name           String
  palette        Int           @default(1) @db.SmallInt
  ownerKind      OwnerKind     @default(HOUSE) @map("owner_kind")
  ownerUserId    String?       @map("owner_user_id") @db.Uuid
  owner          User?         @relation(fields: [ownerUserId], references: [id])
  /// Upgrade levels (0-5) and sidegrade; the stat columns below are derived from them.
  lifeLevel      Int           @default(0) @map("life_level") @db.SmallInt
  attackLevel    Int           @default(0) @map("attack_level") @db.SmallInt
  defenseLevel   Int           @default(0) @map("defense_level") @db.SmallInt
  powerLevel     Int           @default(0) @map("power_level") @db.SmallInt
  sidegrade      Sidegrade?
  /// Equipped overlay cosmetics picked by the owner (see CosmeticChoice); null = automatic (best earned).
  cosmetics      Json?
  /// Effective stats (see CharacterStats), recomputed on every upgrade.
  lifePct        Int           @default(100) @map("life_pct") @db.SmallInt
  startPower     Int           @default(0) @map("start_power")
  attackPct      Int           @default(100) @map("attack_pct") @db.SmallInt
  defensePct     Int           @default(100) @map("defense_pct") @db.SmallInt
  wins           Int           @default(0)
  losses         Int           @default(0)
  /// Glicko-2 (Glicko scale).
  rating         Float
  deviation      Float
  volatility     Float
  tier           Tier
  enabled        Boolean       @default(true)
  disabledReason String?       @map("disabled_reason")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tierHistory    TierHistory[]
  fightsAsSide1  Fight[]       @relation("FightSide1")
  fightsAsSide2  Fight[]       @relation("FightSide2")
  fightsWon      Fight[]       @relation("FightWinner")
  loadouts       FightLoadout[]
  changes        CharacterChange[]
  titles         CharacterTitle[]
  challengesSent Challenge[]    @relation("ChallengerCharacter")
  challengesGot  Challenge[]    @relation("ChallengedCharacter")

  @@unique([fighterId, serial])
  @@index([tier, enabled])
  @@index([ownerUserId])
  @@map("character")
}

model TierHistory {
  id          BigInt           @id @default(autoincrement())
  characterId String           @map("character_id") @db.Uuid
  character   Character        @relation(fields: [characterId], references: [id])
  fromTier    Tier?            @map("from_tier")
  toTier      Tier             @map("to_tier")
  rating      Float
  reason      TierChangeReason
  /// Fight that caused the change.
  fightId     String?          @map("fight_id") @db.Uuid
  fight       Fight?           @relation(fields: [fightId], references: [id])
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([characterId, createdAt])
  @@map("tier_history")
}

// ---------------------------------------------------------------------------
// Fights (build step 5)

enum FightState {
  BOOKED
  BETTING_OPEN
  LOCKED
  IN_PROGRESS
  SETTLING
  SETTLED
  VOIDING
  VOIDED
}

enum VoidReason {
  DRAW
  ENGINE_CRASH
  ENGINE_TIMEOUT
  RECONCILE_ORPHANED
  ADMIN
}

enum CycleSegment {
  MATCHMAKING
  TOURNAMENT
  EXHIBITION
}

enum PairKind {
  CLOSE
  UPSET
  NEAREST
  CROSS_TIER
  /// Exhibition: an owner-vs-owner challenge.
  CHALLENGE
  /// Exhibition: house characters from the top of the rankings.
  SHOWCASE
}

model Fight {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human-friendly fight number.
  number            Int               @unique @default(autoincrement())
  state             FightState        @default(BOOKED)
  /// Optimistic concurrency: every transition bumps it.
  version           Int               @default(0)
  /// "live" or "fake". "sim" never books fights.
  engineMode        String            @map("engine_mode")
  cycle             Int
  segment           CycleSegment
  segmentIndex      Int               @map("segment_index")
  pairKind          PairKind          @map("pair_kind")
  stageId           String            @map("stage_id")
  stage             Stage             @relation(fields: [stageId], references: [id])
  /// The characters the runner launches on each side. Settlement maps the winning side to these.
  side1CharacterId  String            @map("side1_character_id") @db.Uuid
  side1Character    Character         @relation("FightSide1", fields: [side1CharacterId], references: [id])
  side2CharacterId  String            @map("side2_character_id") @db.Uuid
  side2Character    Character         @relation("FightSide2", fields: [side2CharacterId], references: [id])
  roundsToWin       Int               @default(2) @map("rounds_to_win") @db.SmallInt
  bookedAt          DateTime          @default(now()) @map("booked_at") @db.Timestamptz(3)
  bettingOpensAt    DateTime?         @map("betting_opens_at") @db.Timestamptz(3)
  bettingClosesAt   DateTime?         @map("betting_closes_at") @db.Timestamptz(3)
  lockedAt          DateTime?         @map("locked_at") @db.Timestamptz(3)
  startedAt         DateTime?         @map("started_at") @db.Timestamptz(3)
  endedAt           DateTime?         @map("ended_at") @db.Timestamptz(3)
  closedAt          DateTime?         @map("closed_at") @db.Timestamptz(3)
  /// 1 or 2 once the engine reports a winner. Draws void instead.
  winnerSide        Int?              @map("winner_side") @db.SmallInt
  winnerCharacterId String?           @map("winner_character_id") @db.Uuid
  winnerCharacter   Character?        @relation("FightWinner", fields: [winnerCharacterId], references: [id])
  voidReason        VoidReason?       @map("void_reason")
  voidDetail        String?           @map("void_detail")
  loadouts          FightLoadout[]
  odds              FightOdds?
  rounds            FightRound[]
  transitions       FightTransition[]
  bets              Bet[]
  accounts          Account[]
  ledgerTxns        LedgerTxn[]
  tierChanges       TierHistory[]
  titles            CharacterTitle[]
  challenge         Challenge?

  @@index([state])
  @@index([bookedAt])
  @@map("fight")
}

/// Both sides' loadouts, frozen when betting opens. Immutable except the post-fight rating columns.
model FightLoadout {
  fightId        String    @map("fight_id") @db.Uuid
  fight          Fight     @relation(fields: [fightId], references: [id])
  side           Int       @db.SmallInt
  characterId    String    @map("character_id") @db.Uuid
  character      Character @relation(fields: [characterId], references: [id])
  fighterId      String    @map("fighter_id")
  name           String
  tier           Tier
  lifePct        Int       @map("life_pct") @db.SmallInt
  startPower     Int       @map("start_power")
  attackPct      Int       @map("attack_pct") @db.SmallInt
  defensePct     Int       @map("defense_pct") @db.SmallInt
  rating         Float
  deviation      Float
  volatility     Float
  wins           Int
  losses         Int
  /// Overlay cosmetics shown for this fight (see Cosmetics).
  cosmetics      Json      @default("{\"title\":null,\"nameplate\":\"standard\",\"badges\":[]}")
  ratingAfter    Float?    @map("rating_after")
  deviationAfter Float?    @map("deviation_after")
  tierAfter      Tier?     @map("tier_after")

  @@id([fightId, side])
  @@index([characterId])
  @@map("fight_loadout")
}

/// Odds as locked. Chances and multipliers are basis points (1/10000).
model FightOdds {
  fightId        String   @id @map("fight_id") @db.Uuid
  fight          Fight    @relation(fields: [fightId], references: [id])
  modelChanceBp1 Int      @map("model_chance_bp1")
  modelChanceBp2 Int      @map("model_chance_bp2")
  crowdChanceBp1 Int?     @map("crowd_chance_bp1")
  crowdChanceBp2 Int?     @map("crowd_chance_bp2")
  blendWeightBp  Int      @map("blend_weight_bp")
  chanceBp1      Int      @map("chance_bp1")
  chanceBp2      Int      @map("chance_bp2")
  multiplierBp1  Int      @map("multiplier_bp1")
  multiplierBp2  Int      @map("multiplier_bp2")
  pool1          Decimal  @db.Decimal(20, 0)
  pool2          Decimal  @db.Decimal(20, 0)
  cappedPool1    Decimal  @map("capped_pool1") @db.Decimal(20, 0)
  cappedPool2    Decimal  @map("capped_pool2") @db.Decimal(20, 0)
  bettors        Int
  lockedAt       DateTime @default(now()) @map("locked_at") @db.Timestamptz(3)

  @@map("fight_odds")
}

model FightRound {
  fightId    String @map("fight_id") @db.Uuid
  fight      Fight  @relation(fields: [fightId], references: [id])
  round      Int    @db.SmallInt
  /// 1, 2, or 0 for a drawn round.
  winnerSide Int    @map("winner_side") @db.SmallInt
  reason     String

  @@id([fightId, round])
  @@map("fight_round")
}

/// Audit trail: one row per state change.
model FightTransition {
  id        BigInt      @id @default(autoincrement())
  fightId   String      @map("fight_id") @db.Uuid
  fight     Fight       @relation(fields: [fightId], references: [id])
  fromState FightState? @map("from_state")
  toState   FightState  @map("to_state")
  event     String
  payload   Json
  version   Int
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([fightId, id])
  @@map("fight_transition")
}

// ---------------------------------------------------------------------------
// Accounts (phase 2, step 1)

/// A signed-in device. Only the SHA-256 of the token is stored.
model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("session")
}

enum LoginPurpose {
  /// Sign in to (or create) the account with this email.
  SIGN_IN
  /// Attach this email to the anonymous account that asked, keeping its Salt.
  ATTACH
}

/// A one-time email sign-in link. Only the SHA-256 of the token is stored.
model LoginToken {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  tokenHash String       @unique @map("token_hash")
  purpose   LoginPurpose
  /// The anonymous account to attach the email to (ATTACH only).
  userId    String?      @map("user_id") @db.Uuid
  user      User?        @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(3)

  @@index([email, createdAt])
  @@map("login_token")
}

// ---------------------------------------------------------------------------
// Upgrades (phase 2, step 3)

/// Every upgrade and sidegrade change, kept with the character (DESIGN §8: history travels with it).
model CharacterChange {
  id            BigInt              @id @default(autoincrement())
  characterId   String              @map("character_id") @db.Uuid
  character     Character           @relation(fields: [characterId], references: [id])
  kind          CharacterChangeKind
  /// UPGRADE: which stat and levels.
  stat          String?
  fromLevel     Int?                @map("from_level") @db.SmallInt
  toLevel       Int?                @map("to_level") @db.SmallInt
  /// SIDEGRADE: before and after (null = none).
  fromSidegrade Sidegrade?          @map("from_sidegrade")
  toSidegrade   Sidegrade?          @map("to_sidegrade")
  cost          Decimal             @db.Decimal(20, 0)
  txnId         String?             @unique @map("txn_id") @db.Uuid
  txn           LedgerTxn?          @relation(fields: [txnId], references: [id])
  /// Who paid for it (the owner at the time).
  byUserId      String              @map("by_user_id") @db.Uuid
  byUser        User                @relation(fields: [byUserId], references: [id])
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([characterId, id])
  @@map("character_change")
}

// ---------------------------------------------------------------------------
// Titles (phase 2, step 4)

enum TitleCode {
  FIRST_BLOOD
  WINS_10
  WINS_100
  GIANT_SLAYER
  TIER_B
  TIER_A
  TIER_S
  TOURNAMENT_CHAMPION
}

/// A title a character earned (DESIGN §8). Permanent: it stays with the character
/// when it changes hands, and records who owned it when it was earned.
model CharacterTitle {
  id          BigInt    @id @default(autoincrement())
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id])
  code        TitleCode
  /// The fight that earned it.
  fightId     String?   @map("fight_id") @db.Uuid
  fight       Fight?    @relation(fields: [fightId], references: [id])
  /// Owner at the time it was earned.
  ownerKind   OwnerKind @map("owner_kind")
  ownerUserId String?   @map("owner_user_id") @db.Uuid
  owner       User?     @relation(fields: [ownerUserId], references: [id])
  earnedAt    DateTime  @default(now()) @map("earned_at") @db.Timestamptz(3)

  @@index([characterId, id])
  @@index([fightId])
  @@map("character_title")
}

// ---------------------------------------------------------------------------
// Exhibitions (phase 2, step 5)

enum ChallengeStatus {
  /// Waiting for the challenged owner's answer.
  PENDING
  /// Accepted: waiting for the exhibition segment (oldest first).
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
  /// A fight was booked for it.
  BOOKED
}

/// An owner-vs-owner exhibition challenge (DESIGN §5).
model Challenge {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challengerUserId      String          @map("challenger_user_id") @db.Uuid
  challenger            User            @relation("ChallengeFrom", fields: [challengerUserId], references: [id])
  challengerCharacterId String          @map("challenger_character_id") @db.Uuid
  challengerCharacter   Character       @relation("ChallengerCharacter", fields: [challengerCharacterId], references: [id])
  /// Owner of the challenged character when the challenge was sent.
  challengedUserId      String          @map("challenged_user_id") @db.Uuid
  challenged            User            @relation("ChallengeTo", fields: [challengedUserId], references: [id])
  challengedCharacterId String          @map("challenged_character_id") @db.Uuid
  challengedCharacter   Character       @relation("ChallengedCharacter", fields: [challengedCharacterId], references: [id])
  status                ChallengeStatus @default(PENDING)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  /// A PENDING challenge expires after this.
  expiresAt             DateTime        @map("expires_at") @db.Timestamptz(3)
  /// Queue order for accepted challenges.
  acceptedAt            DateTime?       @map("accepted_at") @db.Timestamptz(3)
  /// When it was declined, cancelled, expired or booked.
  closedAt              DateTime?       @map("closed_at") @db.Timestamptz(3)
  fightId               String?         @unique @map("fight_id") @db.Uuid
  fight                 Fight?          @relation(fields: [fightId], references: [id])

  @@index([status, acceptedAt])
  @@index([challengerUserId, status])
  @@index([challengedUserId, status])
  @@map("challenge")
}
