{
  "name": "greed-island",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "pnpm --filter @greed-island/db run db:generate",
    "db:migrate": "pnpm --filter @greed-island/db run db:migrate",
    "db:migrate:dev": "pnpm --filter @greed-island/db run db:migrate:dev",
    "ledger:audit": "pnpm --filter @greed-island/db run ledger:audit",
    "titles:backfill": "pnpm --filter @greed-island/db run titles:backfill",
    "roster:scan": "pnpm --filter @greed-island/engine run roster:scan",
    "roster:sync": "pnpm --filter @greed-island/engine run roster:sync",
    "ikemen:install-mod": "pnpm --filter @greed-island/engine run ikemen:install-mod",
    "match:once": "pnpm --filter @greed-island/engine run match:once",
    "roster:smoke": "pnpm --filter @greed-island/engine run roster:smoke",
    "demo": "pnpm db:migrate && pnpm roster:sync && pnpm --filter @greed-island/orchestrator run demo",
    "dev": "pnpm db:migrate && pnpm roster:sync && pnpm --filter @greed-island/orchestrator run dev",
    "obs:setup": "pnpm --filter @greed-island/orchestrator run obs:setup",
    "staff:role": "pnpm --filter @greed-island/orchestrator run staff:role",
    "roster:variants": "pnpm --filter @greed-island/engine run roster:variants",
    "service:install": "pnpm --filter @greed-island/orchestrator run service install",
    "service:uninstall": "pnpm --filter @greed-island/orchestrator run service uninstall",
    "service:status": "pnpm --filter @greed-island/orchestrator run service status",
    "db:backup": "zsh scripts/backup-db.sh",
    "templates:build": "pnpm --filter @greed-island/engine run templates:build"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
